{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reusable project profile",
  "type": "object",
  "required": [
    "profile_version",
    "name",
    "language",
    "jurisdictions",
    "variables"
  ],
  "properties": {
    "profile_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "enum": [
        "he",
        "ar",
        "en",
        "ru"
      ]
    },
    "jurisdictions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "variables": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
